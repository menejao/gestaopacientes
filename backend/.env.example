JWT_SECRET=troque-esta-chave-com-mais-de-32-caracteres
DATA_ENCRYPTION_KEY=troque-esta-chave-com-mais-de-32-caracteres
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:5500,https://seu-frontend.pages.dev
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
TWOFA_ISSUER=SaudeUBS
TWOFA_CHALLENGE_TTL_MS=300000
TWOFA_MAX_ATTEMPTS=5

# Integracao externa para validar conselho no cadastro
# Modos:
# - off: nao consulta provedor externo
# - optional: tenta consultar, mas permite cadastro em fallback
# - required: exige resposta valida do provedor externo
COUNCIL_VERIFY_MODE=required
COUNCIL_VERIFY_PROVIDER=n8n
COUNCIL_VERIFY_URL=https://seu-provedor.com/api/verify-council
COUNCIL_VERIFY_TOKEN=seu_token_aqui
COUNCIL_VERIFY_TIMEOUT_MS=7000
COUNCIL_VERIFY_REQUIRE_EVIDENCE=true
