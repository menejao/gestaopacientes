# Evento alvo
EVENT_URL=https://www.ticketmaster.com.br/event/venda-geral-bts-world-tour-arirang-30-10
TARGET_SECTOR=Arquibancada
TARGET_QUANTITY=1

# Segurança: deixe false até testar fila, setor e página de carrinho.
# Login prévio é opcional. Se a Ticketmaster pedir login depois, o bot aguarda você.
ADD_TO_CART=false
DRY_RUN=true

# Intervalos baixos demais aumentam risco de bloqueio. Use com calma.
# Fora da fila, o bot verifica/recarrega a cada CHECK_INTERVAL_SECONDS.
# Dentro da fila, ele NÃO recarrega a página; só confere a tela periodicamente.
CHECK_INTERVAL_SECONDS=30
QUEUE_CHECK_INTERVAL_SECONDS=60
RELOAD_WHEN_IDLE=true

# Navegador persistente. Mantém cookies/carrinho entre execuções.
BROWSER_PROFILE_DIR=.browser-profile
HEADLESS=false
KEEP_BROWSER_OPEN=true

# WhatsApp: disabled, cloud ou twilio.
WHATSAPP_PROVIDER=disabled
WHATSAPP_TO=55DDDNUMERO

# Meta WhatsApp Cloud API
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v20.0

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=whatsapp:+14155238886
